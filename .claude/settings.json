{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "0"
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx tsc *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "WebFetch(domain:vite.dev)",
      "WebFetch(domain:vite-pwa-org.netlify.app)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:developer.mozilla.org)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(npm publish *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)"
    ]
  },
  "skillOverrides": {
    "frontend-design": "user-invocable-only"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  }
}
